{
  "swagger": "2.0",
  "info": {
    "title": "taxi/v1/taxi.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "TaxiService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/asset/topup": {
      "post": {
        "summary": "TopupWithAsset rpc returns a transaction (pset) with a LBTC input and a payout with defined asset fot taxi.\nThe transaction is signed with SIGHASH_SINGLE | ANYONECANPAY",
        "operationId": "TaxiService_TopupWithAsset",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1TopupWithAssetResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1TopupWithAssetRequest"
            }
          }
        ],
        "tags": [
          "TaxiService"
        ]
      }
    },
    "/v1/assets": {
      "get": {
        "summary": "ListAssets rpc returns a subset of supported elements assets that could be accepted as payment\nfor topups",
        "operationId": "TaxiService_ListAssets",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListAssetsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "TaxiService"
        ]
      }
    },
    "/v1/payout/topup": {
      "post": {
        "summary": "TopupWithKnownPayout adds ins and outs to the given transaction if this contains at least one\nknown payout, ie. one output with a \"whitelisted\" script.",
        "operationId": "TaxiService_TopupWithKnownPayout",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1TopupWithKnownPayoutResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1TopupWithKnownPayoutRequest"
            }
          }
        ],
        "tags": [
          "TaxiService"
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1AssetDetails": {
      "type": "object",
      "properties": {
        "assetHash": {
          "type": "string",
          "title": "the asset hash used as identifier on the network"
        },
        "basisPoint": {
          "type": "integer",
          "format": "int64",
          "title": "the taxi service fee expressed in basis points for the given asset"
        },
        "assetPrice": {
          "type": "number",
          "format": "double",
          "title": "the price = the amount of assets to equal 1 BTC"
        }
      }
    },
    "v1BlindingData": {
      "type": "object",
      "properties": {
        "asset": {
          "type": "string"
        },
        "value": {
          "type": "string",
          "format": "uint64"
        },
        "assetBlinder": {
          "type": "string",
          "format": "byte"
        },
        "valueBlinder": {
          "type": "string",
          "format": "byte"
        }
      }
    },
    "v1ListAssetsResponse": {
      "type": "object",
      "properties": {
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/v1AssetDetails"
          },
          "title": "all the assets available for topups"
        }
      }
    },
    "v1Topup": {
      "type": "object",
      "properties": {
        "topupId": {
          "type": "string",
          "title": "the unique id of the topup"
        },
        "partial": {
          "type": "string",
          "title": "the partial tx with paid network fees"
        }
      }
    },
    "v1TopupWithAssetRequest": {
      "type": "object",
      "properties": {
        "assetHash": {
          "type": "string",
          "title": "asset hash to be used for payout"
        },
        "estimatedTxSize": {
          "type": "string",
          "format": "uint64",
          "title": "the estimated tx size to cover network fees for"
        },
        "millisatPerByte": {
          "type": "string",
          "format": "uint64",
          "title": "how many millisatoshi per byte we want to spend. ie. 0.1 sat/byte = 100 mSats/byte"
        }
      }
    },
    "v1TopupWithAssetResponse": {
      "type": "object",
      "properties": {
        "topup": {
          "$ref": "#/definitions/v1Topup",
          "title": "the Topup message"
        },
        "expiry": {
          "type": "string",
          "format": "int64",
          "title": "the unix timestamp of the topup expiration date. After that date, the taxi sends the locked utxos to itself to prevent being spent by others"
        },
        "assetHash": {
          "type": "string",
          "title": "the asset hash used as payout for bitcoin fees"
        },
        "assetAmount": {
          "type": "string",
          "format": "uint64",
          "title": "the asset denominated amount expressed in satoshis to be used as payout. It includes also the spread as taxi service fee"
        },
        "assetSpread": {
          "type": "string",
          "format": "uint64",
          "title": "the spread amount expressed in asset denominated satoshis used to pay the taxi service fees"
        },
        "inBlindingData": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/v1BlindingData"
          },
          "title": "Taxi's inputs revealed data in case of confidential inputs"
        }
      }
    },
    "v1TopupWithKnownPayoutRequest": {
      "type": "object",
      "properties": {
        "partial": {
          "type": "string",
          "title": "transaction in base64 format including the known payout"
        },
        "millisatPerByte": {
          "type": "string",
          "format": "uint64",
          "title": "how many millisatoshi per byte we want to spend"
        },
        "unblindedInputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/v1UnblindedInput"
          },
          "title": "Users inputs revealed data in case of confidential inputs, used to blind users output"
        }
      }
    },
    "v1TopupWithKnownPayoutResponse": {
      "type": "object",
      "properties": {
        "topup": {
          "$ref": "#/definitions/v1Topup",
          "title": "the Topup message"
        },
        "expiry": {
          "type": "string",
          "format": "int64",
          "title": "the unix timestamp after wich the locked LBTC input will be double-spent"
        }
      }
    },
    "v1UnblindedInput": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "format": "int64"
        },
        "asset": {
          "type": "string"
        },
        "amount": {
          "type": "string",
          "format": "uint64"
        },
        "assetBlinder": {
          "type": "string"
        },
        "amountBlinder": {
          "type": "string"
        }
      }
    }
  }
}
