#!/bin/bash

scp ./Caddyfile $(terraform -chdir=./terraform output -raw user_host):./
scp ./docker-compose.yml $(terraform -chdir=./terraform output -raw user_host):./
docker build --pull --rm -f "Dockerfile" -t taxid:latest "."
docker save taxid:latest | ssh -C $(terraform -chdir=./terraform output -raw user_host) docker load
