#!/bin/bash

set -ex

PARENT_PATH=$(dirname $(
  cd $(dirname $0)
  pwd -P
))

pushd $PARENT_PATH
rm -rf bin && mkdir -p bin
docker build -t taxi-builder:latest -f resources/linuxbuild/Dockerfile .
docker run --name linux-build taxi-builder:latest
docker cp linux-build:/taxi-daemon/bin/taxid ./bin/taxid
docker cp linux-build:/taxi-daemon/bin/taxi ./bin/taxi
docker rm linux-build
#docker rmi taxi-builder:latest
popd
